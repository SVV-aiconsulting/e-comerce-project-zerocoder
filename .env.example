# Шаблон .env — скопируйте: cp .env.example .env
# Сохраняйте в UTF-8 без BOM (важно для Windows).
#
# Сценарии:
#   Docker Compose локально (docker-compose.yml) — значения ниже как есть.
#   Без Docker на хосте — POSTGRES_HOST=localhost, BACKEND_API_BASE_URL=http://localhost:8000
#   VPS прод (docker-compose.prod.yml) — см. блок «VPS» в конце файла.

# --- Django (локальная разработка) ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_SETTINGS_MODULE=config.settings.local

# --- PostgreSQL ---
POSTGRES_DB=webmarket
POSTGRES_USER=webmarket
POSTGRES_PASSWORD=webmarket
POSTGRES_HOST=db
POSTGRES_PORT=5432
ADAPTER_API_TOKENS=replace-with-strong-shared-token
ADAPTER_API_PUBLIC_CATALOG=True

# --- Единая очередь Celery/Redis ---
# Для запуска без Docker используйте redis://127.0.0.1:6379/0.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
INTAKE_EVENT_LEASE_SECONDS=300
INTAKE_DISPATCH_BATCH_SIZE=100
INTAKE_MAX_PROCESSING_ATTEMPTS=5
INTAKE_RETRY_BASE_SECONDS=10
INTAKE_RETRY_MAX_SECONDS=300

# --- GigaChat NLU ---
# Не коммитьте ключ. Для личного проекта scope обычно GIGACHAT_API_PERS.
AI_ORDER_PROCESSING_ENABLED=False
GIGACHAT_CREDENTIALS=
# Совместимое имя для уже созданной локальной конфигурации:
# GIGACHAT_TOKEN=<тот же ключ авторизации>
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Путь к официальному корневому сертификату НУЦ Минцифры при необходимости.
GIGACHAT_CA_BUNDLE=
GIGACHAT_VERIFY_SSL=True
GIGACHAT_TIMEOUT_SECONDS=30
GIGACHAT_MAX_TOKENS=1600
GIGACHAT_TEMPERATURE=0.1
CATALOG_MATCH_AUTO_THRESHOLD=0.75
CATALOG_MATCH_MIN_MARGIN=0.15
CATALOG_MATCH_CANDIDATE_THRESHOLD=0.25
INTAKE_MAX_CLARIFICATION_ATTEMPTS=3

# --- Telegram-бот (см. docs/TELEGRAM_BOT.md) ---
TELEGRAM_BOT_TOKEN=
BACKEND_API_BASE_URL=http://web:8000
ADAPTER_API_TOKEN=replace-with-strong-shared-token
TELEGRAM_BOT_USE_POLLING=true
TELEGRAM_BOT_LOG_LEVEL=INFO
TELEGRAM_AI_POLL_ATTEMPTS=20
TELEGRAM_AI_POLL_INTERVAL_SECONDS=0.75
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# --- VK-бот (см. docs/VK_BOT.md) ---
VK_BOT_TOKEN=
VK_GROUP_ID=
VK_BOT_LOG_LEVEL=INFO
VK_BOT_USE_LONGPOLL=True
VK_AI_POLL_ATTEMPTS=20
VK_AI_POLL_INTERVAL_SECONDS=0.75

# --- Email-канал: Яндекс Почта IMAP/SMTP ---
EMAIL_CHANNEL_ENABLED=False
YANDEX_EMAIL_ADDRESS=
YANDEX_EMAIL_APP_PASSWORD=
YANDEX_IMAP_HOST=imap.yandex.ru
YANDEX_IMAP_PORT=993
YANDEX_IMAP_FOLDER=INBOX
YANDEX_SMTP_HOST=smtp.yandex.ru
YANDEX_SMTP_PORT=465
EMAIL_POLL_INTERVAL_SECONDS=60
EMAIL_RESPONSE_DISPATCH_INTERVAL_SECONDS=15
EMAIL_POLL_BATCH_SIZE=50
EMAIL_MAX_MESSAGE_BYTES=5242880
EMAIL_OUTBOUND_LEASE_SECONDS=300
EMAIL_OUTBOUND_MAX_ATTEMPTS=5
EMAIL_NETWORK_TIMEOUT_SECONDS=30

# --- Яндекс Доставка по России ---
# На разработке и первом deployment используется только официальный test-контур.
# Публичный тестовый Bearer-токен возьмите из docs/YANDEX_DELIVERY.md или
# актуальной официальной документации; не используйте здесь коммерческий токен.
YANDEX_DELIVERY_ENABLED=False
YANDEX_DELIVERY_ENVIRONMENT=test
YANDEX_DELIVERY_TEST_TOKEN=
YANDEX_DELIVERY_TEST_STATION_ID=fbed3aa1-2cc6-4370-ab4d-59c5cc9bb924
YANDEX_DELIVERY_TIMEOUT_SECONDS=20
# Для теста можно оставить пустым; перед production заполнить реквизитами продавца.
YANDEX_DELIVERY_MERCHANT_INN=
# -1 = без НДС; допустимые значения API: -1, 0, 5, 7, 10, 22.
YANDEX_DELIVERY_VAT_CODE=-1

# Production включается только после договора и выполнения deployment-чек-листа.
# Одновременно требуются environment=production и отдельный предохранитель True.
YANDEX_DELIVERY_PRODUCTION_ENABLED=False
YANDEX_DELIVERY_PRODUCTION_TOKEN=
YANDEX_DELIVERY_PRODUCTION_STATION_ID=

# --- ЮKassa ---
# Для MVP используется тестовый магазин. Не публикуйте secret_key и не ставьте
# его в README, документацию или журнал webhook.
YOOKASSA_ENABLED=False
YOOKASSA_ENVIRONMENT=test
YOOKASSA_TEST_SHOP_ID=
YOOKASSA_TEST_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:8000/payment/return/
YOOKASSA_TIMEOUT_SECONDS=20
# 1 = без НДС. Перед production сверить с системой налогообложения продавца.
YOOKASSA_DEFAULT_VAT_CODE=1
# В production webhook проверяется по IP и повторным GET платежа у ЮKassa.
YOOKASSA_VERIFY_WEBHOOK_IP=True

# Production включается только после договора и HTTPS webhook на VPS.
YOOKASSA_PRODUCTION_ENABLED=False
YOOKASSA_PRODUCTION_SHOP_ID=
YOOKASSA_PRODUCTION_SECRET_KEY=

MAX_BOT_TOKEN=

# --- VPS (docker-compose.prod.yml): замените значения выше на эти ---
# DJANGO_DEBUG=False                    # обязательно; иначе deploy workflow завершится с ошибкой
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_ALLOWED_HOSTS=webmarket.apernova.ru,localhost,127.0.0.1,web,nginx
# DJANGO_CSRF_TRUSTED_ORIGINS=https://webmarket.apernova.ru
# POSTGRES_PASSWORD=change-me-strong-db-password
# ADAPTER_API_PUBLIC_CATALOG=False
# YOOKASSA_RETURN_URL=https://webmarket.apernova.ru/payment/return/
# BACKEND_API_BASE_URL=http://web:8000
